{% extends "default/module.html.jinja2" %}

{% macro is_public(doc) %}
    {#
    Same as pdoc's default is_public, minus the single-underscore-prefix
    check, so that documented private methods (_foo) show up alongside
    public ones. Dunder members (__foo__) stay hidden, except __init__.
    #}
    {% if "@private" in doc.docstring %}
        {# hide members explicitly marked as @private #}
    {% elif "@public" in doc.docstring %}
        {# show members explicitly marked as @public #}
        true
    {% elif not include_undocumented and not doc.docstring and doc.kind != "module" %}
        {# hide members that are undocumented if include_undocumented has been toggled off. #}
    {% elif doc.name == "__init__" and (doc.docstring or (doc.kind == "function" and doc.signature_without_self.parameters)) %}
        {# show constructors that have a docstring or at least one extra argument #}
        true
    {% elif doc.name.startswith("__") and doc.name.endswith("__") %}
        {# hide dunder attributes/methods other than __init__, handled above #}
    {% elif doc.kind == "variable" and doc.is_typevar and not doc.docstring %}
        {# do not document TypeVars, that only clutters the docs. #}
    {% elif doc.kind == "module" and doc.fullname not in all_modules %}
        {# Skip modules that were manually excluded, https://github.com/mitmproxy/pdoc/issues/334 #}
    {% else %}
        true
    {% endif %}
{% endmacro %}

{% block nav_submodules %}
    {#
    pdoc's default `module.submodules` only lists submodules named in the
    package's __all__. Since __all__ here curates the top-level re-exported
    API rather than naming submodules, that leaves the sidebar with no link
    to config/protocol/pwm/stepper. List direct submodules from all_modules
    instead, ignoring __all__.
    #}
    {% set direct_submodules = [] %}
    {% for name, mod in all_modules.items() %}
        {% if name.startswith(module.modulename ~ ".") and name.count(".") == module.modulename.count(".") + 1 %}
            {% set _ = direct_submodules.append(mod) %}
        {% endif %}
    {% endfor %}
    {% if direct_submodules %}
        <h2>Submodules</h2>
        <ul>
            {% for submodule in direct_submodules if is_public(submodule) | trim %}
                <li>{{ submodule.taken_from | link(text=submodule.name) }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
